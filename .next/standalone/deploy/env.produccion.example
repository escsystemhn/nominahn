# ═══════════════════════════════════════════════════════════════════════════
# Plantilla de .env.local PARA EL SERVIDOR (producción o demo).
#
# Se crea directamente en el servidor (nunca se sube desde Windows) en
# /home/deploy/nominahn/.env.local con permisos 600. 03-app.sh comprueba que
# estén las obligatorias antes de tocar nada.
#
# Los secretos son NUEVOS: no reutilices los de desarrollo. Genéralos con los
# comandos indicados en cada bloque. Guarda CIFRADO_KEY en un lugar seguro fuera
# del servidor: sin ella, restaurar la base deja ilegibles las contraseñas guardadas.
# ═══════════════════════════════════════════════════════════════════════════

TZ="America/Tegucigalpa"

# Sale de 02-postgres.sh; pégala tal cual.
DATABASE_URL="postgresql://nomina_app:CLAVE@localhost:5432/nominahn?schema=public"

# El dominio público real, con https. Sin AUTH_URL, /api/auth responde 500.
AUTH_URL="https://nomina.sudominio.hn"
NEXTAUTH_URL="https://nomina.sudominio.hn"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Correo de los comprobantes. DigitalOcean BLOQUEA los puertos 25, 465 y 587 en
# todos sus droplets: usa un proveedor que acepte el 2525. Brevo: host
# smtp-relay.brevo.com, puerto 2525, usuario = el login SMTP de la cuenta y
# SMTP_PASS = una «SMTP key» (no la API key). El remitente debe ser de un dominio
# autenticado en el proveedor (SPF y DKIM) o los comprobantes irán a no deseados.
# Esto es el respaldo: lo que se guarde en Configuración → Correo saliente manda.
# Para una demo sin correo real, un sandbox tipo Mailtrap (también en 2525).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Gestión360 Nómina <nomina@sudominio.hn>"

# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Obligatoria en producción (src/lib/env.ts): cifra las contraseñas de correo,
# respaldos, SAP y relojes guardadas en la base. No la cambies una vez en uso.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIFRADO_KEY=""

UPLOAD_DIR="/var/uploads"
MAX_FILE_SIZE=5242880

# Configuración → Respaldos: carpeta que propone para «Disco local» (la crea
# 01-servidor.sh) y el pg_dump de la misma versión que el servidor de la base.
RESPALDOS_DIR="/var/backups/gestion360"
PG_BIN_DIR="/usr/lib/postgresql/18/bin"
