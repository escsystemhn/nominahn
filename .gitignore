# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# Claves, certificados y almacenes de credenciales (p. ej. la CA del Service
# Layer de SAP, que va en NODE_EXTRA_CA_CERTS en el servidor, nunca aquí).
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.kdbx
id_rsa*
id_ed25519*

# archivos subidos por usuarios (CVs, adjuntos)
# /public/uploads es la ubicación LEGADA (pública, insegura). La nueva es privada:
/public/uploads
/var/

# Volcados y respaldos de base de datos: llevan salarios, identidades, RTN y
# cuentas bancarias. prisma/sql/*.sql SÍ va al repositorio (son los triggers),
# por eso aquí no se ignora *.sql.
*.dump
*.backup
*.bak
/respaldos/
Datos.txt

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: ninguno va al repositorio salvo la plantilla sin valores.
.env*
!.env.example

# Ajustes locales de Claude Code y del editor.
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
