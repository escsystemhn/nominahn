  aplicarEn       String         @default("SIGUIENTE_PLANILLA") // SIGUIENTE_PLANILLA | INMEDIATO
  activo          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

