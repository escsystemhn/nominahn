/// Impuesto personal o vecinal — tabla progresiva por municipio.
///
/// Art. 77 de la Ley de Municipalidades: cada municipalidad aprueba su Plan de
/// Arbitrios cada año, con su propio Anexo de tarifas. Por eso la tabla vive en
/// base de datos y no en el código: un Plan nuevo se carga sin desplegar.
///
/// `porMillar` son lempiras por cada mil de la PORCIÓN del ingreso anual que
/// cae en este tramo. El impuesto total es la SUMA de todos los tramos que el
/// ingreso atraviesa, no una tarifa única aplicada al total.
model TablaImpuestoVecinal {
  id         String   @id @default(cuid())
  /// Municipio al que corresponde la tabla (p. ej. "SAN_PEDRO_SULA").
  municipio  String
  anio       Int
  rangoDesde Decimal  @db.Decimal(14, 2)
  /// `null` = último tramo, sin techo.
  rangoHasta Decimal? @db.Decimal(14, 2)
  porMillar  Decimal  @db.Decimal(8, 4)
  activa     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([municipio, anio, rangoDesde])
  @@index([municipio, anio, activa])
}

model SalarioMinimo {
  id            String   @id @default(cuid())
  anio          Int
  sector        String   @default("GENERAL")
  monto         Decimal  @db.Decimal(12, 2)
  fechaVigencia DateTime @db.Date
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

