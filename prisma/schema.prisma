// ─── CORREO SALIENTE ─────────────────────────────────────────────────────────

/// Servidor SMTP con el que se envían los comprobantes de pago.
///
/// Una sola fila (id = "default"). Antes el servidor sólo podía fijarse con
/// variables de entorno, lo que exigía acceso al servidor para cambiar de
/// proveedor de correo. Si esta fila no existe o está inactiva, el envío cae a
/// las variables SMTP_* para no romper las instalaciones que ya las usan.
model ConfiguracionCorreo {
  id              String   @id @default("default")
  host            String
  puerto          Int      @default(587)
  /// SSL/TLS directo (típico puerto 465). Con `false` se negocia STARTTLS (587).
  seguro          Boolean  @default(false)
  usuario         String?
  /// Cifrada con AES-256-GCM. Ver lib/seguridad/cifrado.ts. Nunca sale de la API.
  passwordCifrado String?
  remitenteNombre String   @default("Recursos Humanos")
  remitenteCorreo String
  activo          Boolean  @default(true)
  actualizadoPor  String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// ─── INTEGRACIÓN SAP BUSINESS ONE ─────────────────────────────────────────────

/// Cuándo se manda a SAP el asiento de una planilla.
enum ModoEnvioSap {
  /// Sólo con el botón «Enviar a SAP» de la planilla.
  MANUAL
  /// Al pasar a APROBADA (la planilla ya está sellada con su huella).
  AL_APROBAR
  /// Al pasar a PAGADA (fecha contable = fecha real de pago).
  AL_PAGAR
}

enum EstadoEnvioSap {
  /// En cola; `proximoIntentoAt` dice cuándo le toca.
  PENDIENTE
  /// Un proceso lo tiene tomado (`bloqueadoHasta`).
  ENVIANDO
  /// SAP devolvió el número de asiento.
  ENVIADO
  /// Error de negocio o reintentos agotados: hace falta una persona.
  ERROR
  /// La planilla cambió después de encolar: el payload ya no vale.
  CANCELADO
}

enum TipoEnvioSap {
  ASIENTO
  /// Asiento inverso, al anular una planilla que ya estaba en SAP.
  REVERSO
}

/// Conexión con el Service Layer de SAP B1 y comportamiento del envío.
/// Una sola fila (id = "default"). La contraseña va cifrada (lib/seguridad/cifrado.ts).
model IntegracionSap {
  id                    String       @id @default("default")
  activo                Boolean      @default(false)
  /// https://servidor:50000/b1s/v1/
  urlBase               String
  companyDb             String
  usuario               String
  passwordCifrado       String?
  modoEnvio             ModoEnvioSap @default(MANUAL)
  incluirProvisiones    Boolean      @default(true)
  porCentroCosto        Boolean      @default(false)
  /// Dimensión de B1 (1 a 5) en la que viven los centros de costo.
  dimensionCentro       Int          @default(1)
  /// "PAGO" = fecha de pago de la planilla; "FIN_PERIODO" = último día del período.
  fechaContable         String       @default("PAGO")
  /// TransactionCode de B1 (4 caracteres), opcional.
  codigoTransaccion     String?
  /// Serie de numeración de asientos en B1, opcional.
  serie                 Int?
  /// Variables: {tipo} {desde} {hasta} {empresa}.
  memoPlantilla         String       @default("Planilla {tipo} {desde} al {hasta}")
  /// Longitudes leídas del $metadata del servidor en la última prueba.
  longitudMemo          Int          @default(50)
  longitudLineMemo      Int          @default(50)
  longitudReferencia    Int          @default(100)
  // ─── Base de datos de SAP (SQL Server), SÓLO LECTURA ─────────────────────
  // Valida la base de la empresa y lista las empresas del servidor. La
  // aplicación nunca escribe ahí: los asientos van por el Service Layer.
  /// Servidor o IP del SQL Server de SAP. Vacío = sin conexión a la base.
  dbServidor            String?
  dbPuerto              Int          @default(1433)
  /// Instancia nombrada (SERVIDOR\INSTANCIA); con ella el puerto lo resuelve SQL Browser.
  dbInstancia           String?
  dbUsuario             String?
  /// Cifrada con AES-256-GCM, como la del Service Layer. Nunca sale de la API.
  dbPasswordCifrado     String?
  dbCifrar              Boolean      @default(false)
  dbConfiarCertificado  Boolean      @default(true)
  dbUltimaPruebaAt      DateTime?
  dbUltimaPruebaOk      Boolean?
  dbUltimaPruebaDetalle String?      @db.Text
  /// SAP tiene varias sucursales: cada línea del asiento lleva BPLID.
  usaSucursales         Boolean      @default(false)
  /// Sucursal de SAP para las planillas de toda la empresa (sin sucursal local).
  sapBplIdPorDefecto    Int?
  /// "LOCAL" = catálogo propio; "SAP" = espejo del plan de cuentas de SAP (sólo lectura aquí).
  catalogoOrigen        String       @default("LOCAL")
  catalogoImportadoAt   DateTime?
  catalogoCuentas       Int?
  ultimaPruebaAt        DateTime?
  ultimaPruebaOk        Boolean?
  ultimaPruebaDetalle   String?      @db.Text
  versionSap            String?
  actualizadoPor        String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

/// Cola de salida: un asiento (o su reverso) por planilla.
///
/// `hashCalculo` es la huella de cierre con la que se construyó `payload`:
/// si la planilla se reabre y recalcula, el envío se cancela en vez de mandar
/// cifras viejas. `payload` se guarda tal cual se envía, para la auditoría.
model SapEnvioAsiento {
  id               String         @id @default(cuid())
  planillaId       String
  planilla         Planilla       @relation(fields: [planillaId], references: [id])
  tipo             TipoEnvioSap   @default(ASIENTO)
  estado           EstadoEnvioSap @default(PENDIENTE)
  hashCalculo      String
  payload          Json
  respuesta        Json?
  /// JdtNum (TransId) del asiento en SAP.
  sapTransId       Int?
  /// Número visible del asiento en SAP.
  sapNumero        Int?
  intentos         Int            @default(0)
  proximoIntentoAt DateTime?
  bloqueadoHasta   DateTime?
  errorCodigo      String?
  errorMensaje     String?        @db.Text
  errorTraducido   String?        @db.Text
  esTransitorio    Boolean?
  reversoDeId      String?
  creadoPor        String?
  enviadoAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  bitacora SapBitacora[]

  @@unique([planillaId, tipo])
  @@index([estado, proximoIntentoAt])
}

/// Un renglón por intento de envío, con lo que respondió SAP.
model SapBitacora {
  id          String          @id @default(cuid())
  envioId     String
  envio       SapEnvioAsiento @relation(fields: [envioId], references: [id], onDelete: Cascade)
  intento     Int
  httpStatus  Int?
  duracionMs  Int
  /// OK | RECONCILIADO | ERROR | CANCELADO
  resultado   String
  errorCodigo String?
  mensaje     String?         @db.Text
  createdAt   DateTime        @default(now())

  @@index([envioId, createdAt])
}

// ─── DOCUMENTOS DESDE PLANTILLA ───────────────────────────────────────────────

enum TipoPlantillaDocumento {
  CONSTANCIA_TRABAJO
  CONSTANCIA_SALARIO
  CONTRATO
  CARTA
  OTRO
}

/// Constancias, contratos y cartas con variables del expediente ({{empleado.nombreCompleto}}).
model PlantillaDocumento {
  id             String                 @id @default(cuid())
  codigo         String                 @unique
  nombre         String
  tipo           TipoPlantillaDocumento
  /// Título impreso en el documento.
  titulo         String
  /// Texto con variables; los párrafos se separan con una línea en blanco.
  contenido      String                 @db.Text
  /// El empleado puede emitirla para sí mismo desde Mi espacio.
  autoservicio   Boolean                @default(false)
  /// Sembradas por la aplicación: se editan, no se borran.
  esSistema      Boolean                @default(false)
  activo         Boolean                @default(true)
  actualizadoPor String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  emitidos DocumentoEmitido[]
}

/// Cada documento emitido, con el texto ya resuelto: el PDF se regenera idéntico.
model DocumentoEmitido {
  id              String             @id @default(cuid())
  /// Correlativo por año, p. ej. 2026-000123.
  folio           String             @unique
  plantillaId     String
  plantilla       PlantillaDocumento @relation(fields: [plantillaId], references: [id])
  empleadoId      String
  empleado        Empleado           @relation(fields: [empleadoId], references: [id])
  destinatario    String?
  titulo          String
  contenido       String             @db.Text
  firmanteNombre  String?
  firmanteCargo   String?
  emitidoPor      String?
  porAutoservicio Boolean            @default(false)
  anulado         Boolean            @default(false)
  createdAt       DateTime           @default(now())

  @@index([empleadoId, createdAt])
}

// ─── SOLICITUDES DE PRÉSTAMO Y ANTICIPO ───────────────────────────────────────

enum TipoSolicitudPrestamo {
  PRESTAMO
  ADELANTO
}

enum EstadoSolicitudPrestamo {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

/// El empleado la pide en Mi espacio; al aprobarla se crea la deducción a plazo.
model SolicitudPrestamo {
  id                 String                  @id @default(cuid())
  empleadoId         String
  empleado           Empleado                @relation(fields: [empleadoId], references: [id])
  tipo               TipoSolicitudPrestamo
  monto              Decimal                 @db.Decimal(12, 2)
  cuotas             Int
  /// Cuota por período de pago de la planilla del empleado.
  cuotaPeriodo       Decimal                 @db.Decimal(12, 2)
  motivo             String?                 @db.Text
  estado             EstadoSolicitudPrestamo @default(PENDIENTE)
  /// Límite de descuento estimado al solicitar (Arts. 371 y 372 C.T.).
  limiteCuotaPeriodo Decimal?                @db.Decimal(12, 2)
  excedeLimite       Boolean                 @default(false)
  resueltoPor        String?
  resueltoAt         DateTime?
  observacion        String?                 @db.Text
  deduccionId        String?                 @unique
  deduccion          DeduccionEmpleado?      @relation(fields: [deduccionId], references: [id])
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([estado, createdAt])
  @@index([empleadoId])
}

// ─── INCAPACIDADES DEL IHSS ───────────────────────────────────────────────────

enum TipoIncapacidad {
  ENFERMEDAD_COMUN
  ACCIDENTE_COMUN
  RIESGO_PROFESIONAL
  MATERNIDAD
}

enum EmisorIncapacidad {
  IHSS
  MEDICO_PRIVADO
  SISTEMA_MEDICO_EMPRESA
}

/// Certificado de incapacidad temporal. Las reglas con que se registró quedan
/// congeladas: la planilla de un período cerrado se puede reproducir aunque
/// después cambien los parámetros.
model Incapacidad {
  id                    String            @id @default(cuid())
  empleadoId            String
  empleado              Empleado          @relation(fields: [empleadoId], references: [id])
  tipo                  TipoIncapacidad
  emisor                EmisorIncapacidad @default(IHSS)
  fechaInicio           DateTime          @db.Date
  fechaFin              DateTime          @db.Date
  dias                  Int
  numeroCertificado     String?
  /// Prórroga de otra incapacidad: no reinicia los días a cargo del patrono.
  prorrogaDeId          String?
  prorrogaDe            Incapacidad?      @relation("ProrrogaIncapacidad", fields: [prorrogaDeId], references: [id])
  prorrogas             Incapacidad[]     @relation("ProrrogaIncapacidad")
  /// Días iniciales que paga el patrono al 100 % (Art. 71 Reglamento IHSS 2020).
  diasPatrono           Int
  /// Porcentaje del salario que paga el IHSS como subsidio desde el día siguiente.
  porcentajeSubsidio    Decimal           @db.Decimal(5, 2)
  /// Porcentaje del salario que el patrono sigue pagando en los días del IHSS.
  porcentajeComplemento Decimal           @db.Decimal(5, 2)
  archivoUrl            String?
  observacion           String?           @db.Text
  anulada               Boolean           @default(false)
  registradoPor         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([empleadoId, fechaInicio])
  @@index([fechaInicio, fechaFin])
}

// ─── HORARIOS Y TURNOS ────────────────────────────────────────────────────────

/// Arts. 321 y 322 C.T.: diurna 8 h, mixta 7 h, nocturna 6 h diarias como máximo.
enum TipoJornada {
  DIURNA
  MIXTA
  NOCTURNA
}

model Turno {
  id                 String      @id @default(cuid())
  codigo             String      @unique
  nombre             String
  tipoJornada        TipoJornada @default(DIURNA)
  /// "HH:MM". Una salida anterior a la entrada significa que cruza la medianoche.
  horaEntrada        String
  horaSalida         String
  /// Horas ordinarias; por encima empieza la extra.
  jornadaHoras       Decimal     @db.Decimal(4, 2)
  almuerzoMinutos    Int         @default(60)
  almuerzoDesdeHoras Decimal     @default(6) @db.Decimal(4, 2)
  /// Minutos de gracia antes de contar una llegada tarde.
  toleranciaMinutos  Int         @default(5)
  /// Días laborales ISO (1 = lunes … 7 = domingo), separados por coma.
  diasLaborales      String      @default("1,2,3,4,5")
  /// Turno de quien no tiene asignación. Sólo uno.
  esPorDefecto       Boolean     @default(false)
  activo             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  asignaciones AsignacionTurno[]
  horarioDias  HorarioDia[]
}

/// Qué turno tiene un empleado desde una fecha. La vigente es la de `desde` más reciente.
model AsignacionTurno {
  id         String    @id @default(cuid())
  empleadoId String
  empleado   Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  turnoId    String
  turno      Turno     @relation(fields: [turnoId], references: [id])
  desde      DateTime  @db.Date
  hasta      DateTime? @db.Date
  creadoPor  String?
  createdAt  DateTime  @default(now())

  @@index([empleadoId, desde])
}

// ─── FORMATOS DE ARCHIVO PARA EL BANCO ────────────────────────────────────────

/// Disposición del archivo de pago que exige cada banco. Se configura, no se programa.
model FormatoBanco {
  id             String   @id @default(cuid())
  nombre         String
  /// Sólo empleados cuyo banco contenga este texto, sin distinguir mayúsculas. Vacío = todos.
  filtroBanco    String?
  /// DELIMITADO | ANCHO_FIJO
  tipo           String   @default("DELIMITADO")
  delimitador    String   @default(",")
  encabezado     Boolean  @default(true)
  /// [{ campo, titulo, ancho?, alinear?, relleno?, valor?, formato? }]
  columnas       Json
  extension      String   @default("csv")
  /// utf8 | latin1
  codificacion   String   @default("utf8")
  /// CRLF | LF
  finLinea       String   @default("CRLF")
  /// Línea final con número de registros y total.
  lineaTotal     Boolean  @default(false)
  esSistema      Boolean  @default(false)
  activo         Boolean  @default(true)
  actualizadoPor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── SALUD Y FAMILIA ──────────────────────────────────────────────────────────

/// Datos de salud: sólo con `empleados.salud` o el propio empleado.
model FichaMedica {
  id                   String   @id @default(cuid())
  empleadoId           String   @unique
  empleado             Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipoSangre           String?
  alergias             String?  @db.Text
  enfermedadesCronicas String?  @db.Text
  medicamentos         String?  @db.Text
  discapacidad         String?
  medicoNombre         String?
  medicoTelefono       String?
  observaciones        String?  @db.Text
  actualizadoPor       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum Parentesco {
  CONYUGE
  COMPANERO_HOGAR
  HIJO
  PADRE
  MADRE
  HERMANO
  OTRO
}

model FamiliarEmpleado {
  id                   String     @id @default(cuid())
  empleadoId           String
  empleado             Empleado   @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  nombre               String
  parentesco           Parentesco
  fechaNacimiento      DateTime?  @db.Date
  identidad            String?
  telefono             String?
  esDependiente        Boolean    @default(false)
  esContactoEmergencia Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([empleadoId])
}

/// A quién se pagan las prestaciones en caso de muerte del trabajador.
model BeneficiarioEmpleado {
  id         String     @id @default(cuid())
  empleadoId String
  empleado   Empleado   @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  nombre     String
  parentesco Parentesco
  identidad  String?
  telefono   String?
  porcentaje Decimal    @db.Decimal(5, 2)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([empleadoId])
}

// ─── HORARIOS ROTATIVOS ───────────────────────────────────────────────────────
// Planificación por día de varias sucursales: cobertura mínima por puesto y
// franja, preferencias del personal y planes generados (src/lib/horarios). Un
// plan PUBLICADO es la fuente más específica del turno de cada día (turnoDe).

/// Personal mínimo de un puesto en una franja horaria de una sucursal.
model CoberturaSucursal {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  puestoId   String
  puesto     Puesto   @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  /// Días ISO separados por coma (1 = lunes … 7 = domingo).
  dias       String   @default("1,2,3,4,5,6,7")
  /// "HH:MM". Una hora final igual o anterior a la inicial cruza la medianoche.
  desde      String
  hasta      String
  minimo     Int
  /// «Pico almuerzo», «Valle»…
  etiqueta   String?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sucursalId])
}

/// Horario de atención al público de una sucursal, por día de la semana.
model HorarioAtencion {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  /// Día ISO (1 = lunes … 7 = domingo).
  dia        Int
  apertura   String?
  cierre     String?
  cerrado    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([sucursalId, dia])
}

/// Disponibilidad y restricciones de horario de una persona (estudios, salud, traslados).
model PreferenciaHorario {
  id                   String   @id @default(cuid())
  empleadoId           String   @unique
  empleado             Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  permiteTraslado      Boolean  @default(false)
  /// Sucursales aceptadas para traslado; vacío = cualquiera.
  sucursalesTraslado   String[] @default([])
  /// "HH:MM"; vacío = sin restricción.
  noAntesDe            String?
  noDespuesDe          String?
  /// Días ISO en que rige la restricción de horas; vacío = todos.
  diasRestriccion      String   @default("")
  /// Nada nocturno ni mixto.
  soloDiurna           Boolean  @default(false)
  diasNoDisponible     String   @default("")
  diaDescansoPreferido Int?
  motivo               String?
  updatedAt            DateTime @updatedAt
}

enum EstadoPlanHorario {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum EstadoDiaHorario {
  TURNO
  DESCANSO
  AUSENCIA
}

/// Plan de horarios rotativos de un período (semana, quincena o mes).
model PlanHorario {
  id            String            @id @default(cuid())
  nombre        String
  desde         DateTime          @db.Date
  hasta         DateTime          @db.Date
  sucursalesIds String[]
  estado        EstadoPlanHorario @default(BORRADOR)
  /// Reglas con que se generó (descanso entre jornadas, víspera, rotación…).
  reglas        Json
  /// Conteo de alertas al último guardado: { errores, avisos, faltantes }.
  resumen       Json?
  creadoPor     String?
  publicadoPor  String?
  publicadoAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  dias          HorarioDia[]

  @@index([estado, desde])
}

/// Un día de una persona en un plan.
model HorarioDia {
  id         String           @id @default(cuid())
  planId     String
  plan       PlanHorario      @relation(fields: [planId], references: [id], onDelete: Cascade)
  empleadoId String
  empleado   Empleado         @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha      DateTime         @db.Date
  estado     EstadoDiaHorario
  /// Sucursal donde trabaja ese día (otra que la suya = traslado).
  sucursalId String?
  turnoId    String?
  turno      Turno?           @relation(fields: [turnoId], references: [id])
  /// Minutos desde la medianoche del día; la salida puede pasar de 1440.
  entrada    Int?
  salida     Int?
  pausa      Int              @default(0)
  esTraslado Boolean          @default(false)
  /// Editado a mano después de generarse.
  manual     Boolean          @default(false)
  /// Ausencia (vacaciones, incapacidad) o razón de un descanso adicional.
  motivo     String?

  @@unique([planId, empleadoId, fecha])
  @@index([empleadoId, fecha])
}
