# ═══════════════════════════════════════════════════════════════════════════
# Plantilla de .env.local PARA EL SERVIDOR de la demo.
#
# Se crea directamente en el servidor (nunca se sube desde Windows) en
# /home/deploy/nominahn/.env.local con permisos 600.
#
# Los secretos son NUEVOS: no reutilices los de desarrollo. Genéralos con los
# comandos indicados en cada bloque.
# ═══════════════════════════════════════════════════════════════════════════

TZ="America/Tegucigalpa"

# Sale de 02-postgres.sh; pégala tal cual.
DATABASE_URL="postgresql://nomina_app:CLAVE@localhost:5432/nominahn?schema=public"

# El dominio público real, con https. Sin AUTH_URL, /api/auth responde 500.
AUTH_URL="https://demo.tudominio.hn"
NEXTAUTH_URL="https://demo.tudominio.hn"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Brevo gratuito: smtp-relay.brevo.com:587. Gmail: smtp.gmail.com:587 con
# contraseña de aplicación. Para NO enviar correo real durante la demo, usa un
# sandbox tipo Mailtrap: las claves deben existir igualmente o la app no arranca.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NominaHN Demo <demo@tudominio.hn>"

# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Obligatoria en producción (src/lib/env.ts): cifra las contraseñas de correo,
# SAP y relojes guardadas en la base. No la cambie una vez en uso.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIFRADO_KEY=""

UPLOAD_DIR="/var/uploads"
MAX_FILE_SIZE=5242880
